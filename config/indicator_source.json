  "collectors": {
    "collectors.bullion": {
      "name": "金银现货采集器",
      "module": "collectors.bullion",
      "frequency_minutes": 5,
      "data_source": "gold-api",
      "indicators": ["gold", "silver", "ratio"],
      "url": "https://api.gold-api.com/price/{symbol}",
      "output": {
        "snapshot_keys": ["gold_price", "silver_price", "gold_silver_ratio"],
        "minutely_file": "gold_silver_minutely.csv",
        "minutely_fields": ["gold_usd", "silver_usd", "ratio"]
      }
    },
    "collectors.china_futures": {
      "name": "国内期货主力合约 (AKShare/新浪)",
      "module": "collectors.china_futures",
      "frequency_minutes": 1440,
      "data_source": "akshare-sina",
      "indicators": ["shfe_gold", "shfe_silver"],
      "notes": "免费，无需 API Key，日频 OHLC + 持仓量"
    },
    "collectors.macro": {
      "name": "宏观指标采集器（市场 + 日频基本面）",
      "module": "collectors.macro",
      "frequency_minutes": 5,
      "data_source": "yahoo-finance|ustreasury|fred|cboe-vix",
      "indicators": ["dxy", "treasury_10y", "treasury_2y", "treasury_30y", "tips_10y", "sp500", "vix", "gold_futures", "silver_futures"],
      "url": "https://query1.finance.yahoo.com/v8/finance/chart/{symbol}",
      "output": {
        "snapshot_keys": ["dxy", "treasury_10y", "vix", "gold_futures", "silver_futures"],
        "minutely_file": "yahoo_finance_minutely.csv",
        "extended_file": "yahoo_finance_extended_minutely.csv",
        "unified_file": "unified_gold_silver_volume.csv",
        "daily_files": {
          "treasury":  { "file": "treasury.csv",  "fields": ["10yr", "2yr", "30yr"] },
          "tips_10y":  { "file": "tips.csv",      "field": "value" },
          "dxy":       { "file": "dxy.csv",       "field": "value" },
          "sp500":     { "file": "sp500.csv",     "field": "value" },
          "vix":       { "file": "vix.csv",       "field": "close" }
        },
        "fred_series": {
          "tips":  { "id": "DFII10",    "name": "10-Year TIPS", "indicator": "tips_10y" },
          "dxy":   { "id": "DTWEXBGS",  "name": "Trade Weighted USD Index", "indicator": "dxy" },
          "sp500": { "id": "SP500",     "name": "S&P 500", "indicator": "sp500" }
        }
      }
    },
    "collectors.news_rss": {
      "name": "RSS 新闻采集器",
      "module": "collectors.news_rss",
      "frequency_minutes": 30,
      "data_source": "cnbc|marketwatch",
      "indicators": [],
      "urls": [
        "https://feeds.content.dowjones.io/public/rss/mw_topstories",
        "https://www.cnbc.com/id/10000113/device/rss/rss.html",
        "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664",
        "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000115"
      ],
      "output": {
        "feed_file": "latest_feed.json",
        "events_file": "event_tracker.json"
      }
    }
  },

  "sources": [
    {
      "id": "gold-api",
