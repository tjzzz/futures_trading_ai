  "collectors": {
    "collectors.gold_api": {
      "name": "金银现货采集器",
      "module": "collectors.gold_api",
      "frequency_minutes": 5,
      "data_source": "gold-api.com",
      "indicators": ["gold", "silver", "ratio"],
      "url": "https://api.gold-api.com/price/{symbol}",
      "output": {
        "snapshot_keys": ["gold_price", "silver_price", "gold_silver_ratio"],
        "minutely_file": "gold_silver_minutely.csv",
        "minutely_fields": ["gold_usd", "silver_usd", "ratio"]
      }
    },
    "collectors.yfinance_batch": {
      "name": "Yahoo Finance 批量采集器",
      "module": "collectors.yfinance_batch",
      "frequency_minutes": 5,
      "data_source": "yahoo-finance",
      "indicators": ["dxy", "treasury_10y", "vix", "gold_futures", "silver_futures", "oil_wti", "oil_brent", "copper", "gld_holdings", "slv_holdings", "usdcnh", "fedwatch_prob"],
      "url": "https://query1.finance.yahoo.com/v8/finance/chart/{symbol}",
      "output": {
        "snapshot_keys": ["dxy", "treasury_10y", "vix", "gold_futures", "silver_futures", "oil_wti", "oil_brent", "copper", "gld_holdings", "slv_holdings", "usdcnh", "fedwatch_prob"],
        "minutely_file": "yfinance_minutely.csv"
      }
    },
    "collectors.treasuries": {
      "name": "美债收益率曲线 (U.S. Treasury)",
      "module": "collectors.treasuries",
      "frequency_minutes": 1440,
      "data_source": "ustreasury",
      "indicators": ["treasury_10y", "treasury_2y", "treasury_30y"],
      "url": "https://home.treasury.gov/resource-center/data-chart-center/interest-rates/daily-treasury-rates.csv/2026/all",
      "output": {
        "snapshot_keys": ["treasury", "treasury_10y"],
        "daily_file": "treasury.csv",
        "daily_fields": ["10yr", "2yr", "30yr"]
      }
    },
    "collectors.fred": {
      "name": "FRED 系列 (TIPS 10Y)",
      "module": "collectors.fred",
      "frequency_minutes": 1440,
      "data_source": "fred",
      "indicators": ["tips_10y", "cpi_yoy", "pce_core", "credit_spread"],
      "url": "https://fred.stlouisfed.org/",
      "output": {
        "snapshot_keys": ["tips_10y", "cpi_yoy", "pce_core", "credit_spread"],
        "daily_files": {
          "tips": { "file": "tips.csv", "field": "value" },
          "cpi": { "file": "cpi.csv", "field": "value" },
          "pce": { "file": "pce_core.csv", "field": "value" },
          "credit_hy": { "file": "credit_hy.csv", "field": "value" }
        }
      }
    },
    "collectors.cboe_vix": {
      "name": "CBOE VIX 日频",
      "module": "collectors.cboe_vix",
      "frequency_minutes": 1440,
      "data_source": "cboe-vix",
      "indicators": ["vix"],
      "url": "https://cdn.cboe.com/api/global/us_indices/daily_prices/VIX_History.csv",
      "output": {
        "snapshot_keys": ["vix_daily"],
        "daily_file": "vix.csv"
      }
    },
    "collectors.fallback": {
      "name": "兜底数据采集器 (FRED原油/铜 + ExchangeRate USD/CNY)",
      "module": "collectors.fallback",
      "frequency_minutes": 1440,
      "data_source": "fred|exchangerate-api",
      "indicators": ["oil_wti", "oil_brent", "copper", "usdcnh"],
      "notes": "当 Yahoo Finance 限流时补缺。FRED 日频原油/月度铜，ExchangeRate-API 每日 USD/CNY"
    },
    "collectors.china_futures": {
      "name": "国内期货主力合约 (AKShare/新浪)",
      "module": "collectors.china_futures",
      "frequency_minutes": 1440,
      "data_source": "akshare-sina",
      "indicators": ["shfe_gold", "shfe_silver"],
      "notes": "免费，无需 API Key，日频 OHLC + 持仓量"
    },
    "collectors.news_rss": {
      "name": "RSS 新闻采集器 (七因子)",
      "module": "collectors.news_rss",
      "frequency_minutes": 30,
      "data_source": "cnbc|marketwatch",
      "indicators": [],
      "urls": [
        "https://feeds.content.dowjones.io/public/rss/mw_topstories",
        "https://www.cnbc.com/id/10000113/device/rss/rss.html",
        "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664",
        "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000115"
      ],
      "output": { "feed_file": "latest_feed.json", "events_file": "event_tracker.json" }
    }
  },

